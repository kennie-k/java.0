# ═══════════════════════════════════════════════════════════════════
# SmartRE Kenya — Environment Configuration
# Copy to .env and fill in real values before running
# ═══════════════════════════════════════════════════════════════════

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-64-plus-character-secret-generated-per-environment
JWT_EXPIRATION=86400000

# ── Database ───────────────────────────────────────────────────────
DB_PASSWORD=postgres

# ── Internal Service Auth ──────────────────────────────────────────
INTERNAL_SECRET=replace-with-a-random-32-plus-character-secret-generated-per-environment

# ── M-Pesa Daraja (developer.safaricom.co.ke) ─────────────────────
# 1. Create account at developer.safaricom.co.ke
# 2. Create app, subscribe to Lipa Na M-Pesa Online
# 3. Copy credentials from your app dashboard
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# For development: run `ngrok http 8080` and paste the https URL below
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/payments/mpesa/callback
MPESA_CALLBACK_SECRET=replace-with-a-random-32-plus-character-secret-generated-per-environment
GATEWAY_SIGNING_SECRET=replace-with-a-random-32-plus-character-secret-generated-per-environment
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Sandbox test phone (always succeeds): 254708374149

# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── S3-Compatible Document Storage ────────────────────────────────
# Set S3_ENABLED=false for development (uses test URLs, no real storage)
# For production: use AWS S3, Cloudflare R2, or MinIO
S3_ENABLED=false
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=smartre-documents
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_PUBLIC_BASE_URL=https://smartre-documents.s3.amazonaws.com

# ── External KYC / Verification APIs ──────────────────────────────
# All disabled by default — system works without these for testing
SMILE_IDENTITY_ENABLED=false
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=

ARDHISASA_ENABLED=false
ARDHISASA_API_KEY=

DOCUMENT_ANALYSIS_ENABLED=false
DOCUMENT_ANALYSIS_URL=
DOCUMENT_ANALYSIS_KEY=

BIOMETRIC_HARD_BLOCK=false

# ── Grafana ────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=smartre2026

# ── AlertManager ───────────────────────────────────────────────────
ALERTMANAGER_WEBHOOK_URL=http://your-notification-service/alerts
